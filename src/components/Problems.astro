---
const problems = [
  {
    icon: 'M12 6v6l4 2m6-2a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z',
    title: 'Filas largas en la mañana',
    pain: 'A las 8 a.m. todos quieren su café ya. Si cobrar es lento, la gente se desespera y se va.',
    fix: 'Cobras con unos toques, con todo y leche, tamaño y extras.',
  },
  {
    icon: 'M3 3v18h18M8 17V11m5 6V7m5 10v-4',
    title: 'No saber qué se vende más',
    pain: 'Sin números claros, compras insumos al tanteo y no sabes a qué hora se llena tu negocio.',
    fix: 'Ves tus ventas por hora y tus productos más vendidos.',
  },
  {
    icon: 'M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21.2l8.8-8.8a5.5 5.5 0 0 0 0-7.8Z',
    title: 'Clientes que no regresan',
    pain: 'Alguien te compra una vez y no vuelves a saber de él. Atraer clientes nuevos cuesta más que conservarlos.',
    fix: 'Tarjeta de lealtad digital en su celular, sin descargar apps. El sello se suma solo al cobrar.',
  },
];
---

<section class="bg-crema-200/60 py-20 lg:py-28">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
    <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
      <h2 class="text-4xl leading-[1.08] text-balance sm:text-5xl">
        ¿Te suena <em>familiar</em>?
      </h2>
      <p class="mt-5 max-w-md text-lg text-cafe-700">Lo que más nos cuentan los dueños de cafeterías en Tijuana.</p>
    </div>

    <ol class="border-t border-cafe-900/80">
      {problems.map((p, i) => (
        <li class="grid gap-x-6 gap-y-3 border-b border-cafe-900/15 py-8 sm:grid-cols-[auto_1fr] sm:py-10" data-reveal style={`--delay: ${i * 70}ms`}>
          <span class="font-mono text-sm font-semibold text-acento-700 sm:pt-2" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="flex items-center gap-3 font-display text-2xl font-semibold tracking-tight sm:text-[1.75rem]">
              {p.title}
            </h3>
            <p class="mt-3 text-lg leading-relaxed text-cafe-700">{p.pain}</p>
            <p class="mt-5 flex gap-3 rounded-xl bg-crema-50 px-4 py-3.5 font-semibold text-cafe-900 shadow-soft ring-1 ring-cafe-900/5">
              <svg viewBox="0 0 24 24" class="mt-0.5 size-5 shrink-0 text-acento-600" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={p.icon} /></svg>
              <span><span class="text-acento-700">Con Coffee POS:</span> {p.fix}</span>
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
