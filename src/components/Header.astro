---
import { site } from '../config/site';
import Logo from './Logo.astro';

const link = 'text-sm text-texto-2 transition-colors duration-[180ms] ease-[var(--ease-out)] hover:text-texto';
---

<header id="site-header" class="sticky top-0 z-30 bg-fondo">
  <div class="mx-auto flex h-16 max-w-[1200px] items-center justify-between gap-6 px-4 sm:px-6">
    <a href="#inicio" class="flex items-center gap-2.5" aria-label="Coffee POS, inicio">
      <Logo class="size-7" />
      <span class="font-display text-[1.05rem] font-semibold tracking-[-0.02em]">{site.name}</span>
    </a>
    <nav class="hidden items-center gap-8 md:flex" aria-label="Secciones">
      <a href="#funciones" class={link}>Funciones</a>
      <a href="#pagos" class={link}>Pagos</a>
      <a href="#precio" class={link}>Precio</a>
      <a href="#preguntas" class={link}>Preguntas</a>
    </nav>
    <a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary h-9 px-4 text-sm">
      Pedir demo
    </a>
  </div>
  <!-- Línea de 1px: solo aparece al bajar, para separar el encabezado del contenido. -->
  <div class="header-line h-px bg-borde" aria-hidden="true"></div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const sentinel = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
  sentinel();
  window.addEventListener('scroll', sentinel, { passive: true });
</script>
