---
import { faqs, site } from '../config/site';
---

<section id="preguntas" class="scroll-mt-16 border-t border-borde py-20 lg:py-32">
  <div class="mx-auto grid max-w-[1200px] gap-12 px-4 sm:px-6 lg:grid-cols-12">
    <div class="lg:col-span-5" data-reveal>
      <h2 class="text-4xl leading-[1.08] sm:text-5xl">Preguntas frecuentes</h2>
      <p class="mt-5 text-texto-2">
        ¿Otra duda? <a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer" class="text-link">Escríbeme por WhatsApp</a>.
      </p>
    </div>

    <div class="border-t border-borde lg:col-span-6 lg:col-start-7">
      {faqs.map((f) => (
        <details class="group border-b border-borde">
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-6 py-5 font-medium transition-colors duration-[180ms] ease-[var(--ease-out)] hover:text-cafe">
            {f.q}
            <svg viewBox="0 0 16 16" class="faq-icon size-4 shrink-0 text-texto-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M8 3v10M3 8h10" /></svg>
          </summary>
          <p class="answer pb-6 pr-10 text-texto-2">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
