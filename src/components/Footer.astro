---
import { site } from '../config/site';
import Logo from './Logo.astro';

const link = 'transition-colors duration-[180ms] ease-[var(--ease-out)] hover:text-texto';
---

<footer class="border-t border-borde py-10">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-6 px-4 text-sm text-texto-2 sm:px-6 md:flex-row md:items-center md:justify-between">
    <div class="flex items-center gap-2.5 text-texto">
      <Logo class="size-6" />
      <span class="font-display font-semibold tracking-[-0.02em]">{site.name}</span>
      <span class="text-texto-3">· Tijuana, B.C.</span>
    </div>
    <div class="flex flex-col gap-2 md:flex-row md:gap-6">
      <a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer" class={link}>WhatsApp</a>
      <a href={`mailto:${site.email}`} class={link}>{site.email}</a>
      <a href={site.authorUrl} target="_blank" rel="noopener" class={link}>Hecho por {site.author}</a>
    </div>
  </div>
</footer>
