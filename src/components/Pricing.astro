---
import { plan } from '../config/site';
import WhatsAppButton from './WhatsAppButton.astro';

const check = 'M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.58l7.3-7.3a1 1 0 0 1 1.4 0Z';
---

<section id="precio" class="scroll-mt-16 border-t border-borde py-20 lg:py-32">
  <div class="mx-auto grid max-w-[1200px] gap-12 px-4 sm:px-6 lg:grid-cols-12">
    <div class="lg:col-span-5" data-reveal>
      <h2 class="text-4xl leading-[1.08] sm:text-5xl">Un plan. Precio fijo.</h2>
      <p class="mt-5 max-w-sm text-lg text-texto-2">
        Todo incluido, sin costos escondidos. Lo pruebas {plan.badges[0].toLowerCase()} en tu cafetería y decides después.
      </p>
    </div>

    <div class="rounded-[10px] border border-borde bg-superficie lg:col-span-6 lg:col-start-7" data-reveal style="--d: 1">
      <div class="flex flex-wrap items-end justify-between gap-4 p-6 sm:p-8">
        <div>
          <h3 class="text-xl">{plan.name}</h3>
          <p class="mt-1 text-sm text-texto-2">{plan.note}</p>
        </div>
        <p class="flex items-baseline gap-1.5">
          <span class="font-display text-5xl font-semibold tracking-[-0.04em]">${plan.price}</span>
          <span class="text-sm text-texto-2">{plan.currency} / {plan.period}</span>
        </p>
      </div>

      <ul class="space-y-3 border-t border-borde p-6 sm:p-8">
        {plan.includes.map((item) => (
          <li class="flex gap-3">
            <svg viewBox="0 0 20 20" class="mt-[0.3rem] size-4 shrink-0 text-cafe" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d={check} clip-rule="evenodd" /></svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>

      <dl class="grid grid-cols-2 border-t border-borde text-sm">
        <div class="border-r border-borde p-6 sm:px-8">
          <dt class="text-texto-2">Para empezar</dt>
          <dd class="mt-1 font-mono text-lg text-texto">$0</dd>
        </div>
        <div class="p-6 sm:px-8">
          <dt class="text-texto-2">Prueba gratis</dt>
          <dd class="mt-1 font-mono text-lg text-texto">10 días</dd>
        </div>
      </dl>

      <div class="border-t border-borde p-6 sm:p-8">
        <WhatsAppButton class="w-full" />
      </div>
    </div>
  </div>
</section>
