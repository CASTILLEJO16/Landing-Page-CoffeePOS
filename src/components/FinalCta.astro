---
import { site } from '../config/site';
import WhatsAppButton from './WhatsAppButton.astro';
---

<section class="border-t border-borde bg-banda py-20 lg:py-28">
  <div class="mx-auto grid max-w-[1200px] gap-8 px-4 sm:px-6 lg:grid-cols-12 lg:items-end">
    <h2 class="text-4xl leading-[1.08] sm:text-5xl lg:col-span-7" data-reveal>
      Te lo enseño funcionando, en tu cafetería.
    </h2>
    <div class="lg:col-span-4 lg:col-start-9" data-reveal style="--d: 1">
      <p class="text-texto-2">Sin compromiso. 10 días de prueba gratis y nada que pagar para empezar.</p>
      <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
        <WhatsAppButton />
        <a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer" class="font-mono text-sm text-texto-2 transition-colors duration-[180ms] ease-[var(--ease-out)] hover:text-texto">
          {site.whatsappDisplay}
        </a>
      </div>
    </div>
  </div>
</section>
