---
// Ilustración de la tarjeta de lealtad digital, con los colores de la app.
// TODO: reemplazar por una captura real de la tarjeta en el celular cuando la tengas.
const total = 10;
const filled = 7;

// Patrón decorativo tipo QR (determinista, sin significado).
const qr: [number, number][] = [];
for (let y = 0; y < 9; y++) {
  for (let x = 0; x < 9; x++) {
    const finder = (x < 3 && y < 3) || (x > 5 && y < 3) || (x < 3 && y > 5);
    if (!finder && (x * 7 + y * 3 + x * y) % 3 === 0) qr.push([x, y]);
  }
}
const finders = [[0, 0], [6, 0], [0, 6]];
---

<div class="shot flex justify-center bg-banda! px-6 py-12 sm:py-16" role="img" aria-label="Ilustración de la tarjeta de lealtad digital en el celular del cliente: 7 de 10 sellos y un código QR para escanear en caja">
  <div class="w-full max-w-[19rem] rounded-[10px] border border-borde bg-superficie p-6" aria-hidden="true">
    <div class="flex items-baseline justify-between">
      <p class="font-display text-lg font-semibold tracking-[-0.02em]">Tu cafetería</p>
      <p class="font-mono text-xs text-texto-3">Ana</p>
    </div>
    <p class="mt-0.5 text-sm text-texto-2">Tarjeta de sellos</p>

    <div class="mt-6 grid grid-cols-5 gap-2.5">
      {Array.from({ length: total }, (_, i) => (
        i < filled
          ? <span class="grid aspect-square place-items-center rounded-full bg-cafe text-white">
              <svg viewBox="0 0 24 24" class="size-[50%]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 9h11v4a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5V9Zm11 1.5h1.2a2.3 2.3 0 0 1 0 4.6H16" /></svg>
            </span>
          : <span class="aspect-square rounded-full border border-dashed border-texto-3"></span>
      ))}
    </div>
    <p class="mt-4 text-sm text-texto-2"><span class="font-mono text-texto">{filled}/{total}</span> sellos</p>

    <div class="mt-6 flex items-center gap-4 border-t border-borde pt-5">
      <svg viewBox="0 0 9 9" class="size-16 shrink-0" shape-rendering="crispEdges">
        {finders.map(([x, y]) => (
          <g>
            <rect x={x} y={y} width="3" height="3" fill="#0f172a" />
            <rect x={x + 0.5} y={y + 0.5} width="2" height="2" fill="#ffffff" />
            <rect x={x + 1} y={y + 1} width="1" height="1" fill="#0f172a" />
          </g>
        ))}
        {qr.map(([x, y]) => <rect x={x} y={y} width="1" height="1" fill="#0f172a" />)}
      </svg>
      <p class="text-sm text-texto-2">Muéstralo en caja para sumar tu sello.</p>
    </div>
  </div>
</div>
