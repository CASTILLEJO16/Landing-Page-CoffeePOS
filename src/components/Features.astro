---
import { Picture } from 'astro:assets';
import Screenshot from './Screenshot.astro';
import LoyaltyCardMock from './LoyaltyCardMock.astro';
// Capturas: reemplaza los archivos en src/assets/screenshots/ (mismo nombre = no tocas código).
import personalizacionesImg from '../assets/screenshots/personalizaciones.png';
import adminImg from '../assets/screenshots/admin.png';
import usuariosImg from '../assets/screenshots/usuarios.png';
import movilImg from '../assets/screenshots/movil.png';

// Cada función parte del problema que resuelve. Los ejemplos salen de las capturas reales.
const features = [
  {
    id: 'personalizaciones',
    problem: 'Cada bebida tiene su propio precio',
    title: 'Personalizaciones sin hacer cuentas',
    text: 'Eliges leche, jarabe, tamaño y toppings, y el sistema suma los extras. En la captura: un latte de $62 con avena, vainilla, tamaño grande y canela queda en $99.',
    visual: 'shot',
    img: { src: personalizacionesImg, alt: 'Ventana para personalizar un latte: leche de avena, jarabe de vainilla, tamaño grande y canela. Base $62, extras $37, total $99' },
  },
  {
    id: 'lealtad',
    problem: 'Clientes que compran una vez y no vuelven',
    title: 'Tarjeta de lealtad en su celular',
    text: 'Tu cliente escanea el QR de tu cafetería, se registra con nombre y teléfono y guarda su tarjeta con QR en el celular, sin descargar apps. Al cobrar escaneas su código y el sello se suma solo; con 10 sellos, la recompensa se aplica en la orden. Puede revisar su avance cuando quiera con su número de teléfono.',
    visual: 'loyalty',
  },
  {
    id: 'reportes',
    problem: 'Comprar insumos al tanteo',
    title: 'Ventas por hora, día y producto',
    text: 'Ves a qué hora vendes más, cómo te pagan y qué se vende más. En el ejemplo, el pico es a las 7:00 y el latte es el producto estrella.',
    visual: 'shot',
    img: { src: adminImg, alt: 'Reportes de Coffee POS: ventas por hora con pico a las 7:00, tendencia por día, ventas por método de pago y productos más vendidos con el latte primero' },
  },
  {
    id: 'usuarios',
    problem: 'Que cualquiera pueda cambiar precios',
    title: 'Administrador y vendedor',
    text: 'Tú controlas el menú, los precios y los reportes. Tus vendedores entran con su usuario o PIN y solo ven lo que necesitan para cobrar.',
    visual: 'shot',
    img: { src: usuariosImg, alt: 'Gestión de usuarios: tres usuarios activos con roles de vendedor y administrador, y PIN asignado' },
  },
  {
    id: 'equipos',
    problem: 'Depender de una sola computadora',
    title: 'Funciona en el equipo que ya tienes',
    text: 'Tablet, computadora o celular: abres el navegador y entras. Si un equipo falla, entras desde otro y sigues vendiendo.',
    visual: 'phone',
  },
] as const;

const soon = {
  title: 'Integración con terminal bancaria',
  text: 'El cobro con tarjeta pasará directo de la caja a la terminal, sin teclear el monto dos veces.',
};
---

<section id="funciones" class="scroll-mt-16 border-t border-borde py-20 lg:py-32">
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6">
    <div class="grid gap-6 lg:grid-cols-12">
      <h2 class="text-4xl leading-[1.08] sm:text-5xl lg:col-span-7" data-reveal>Pensado para cómo se trabaja en una barra de café.</h2>
      <p class="max-w-md text-texto-2 lg:col-span-4 lg:col-start-9 lg:self-end" data-reveal style="--d: 1">
        Cada función resuelve algo que nos cuentan los dueños de cafeterías: filas lentas, clientes que no vuelven y números que nadie revisa.
      </p>
    </div>

    <!-- ESCRITORIO: lista de funciones (tabs) + una sola captura que cambia -->
    <div class="mt-16 hidden gap-12 lg:grid lg:grid-cols-12" data-tabs>
      <div class="col-span-5" role="tablist" aria-label="Funciones de Coffee POS" aria-orientation="vertical">
        {features.map((f, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${f.id}`}
            aria-controls={`panel-${f.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="group relative block w-full cursor-pointer border-t border-borde py-6 pr-4 pl-6 text-left last:border-b focus-visible:outline-offset-[-2px]"
          >
            <span class="tab-bar absolute top-0 bottom-0 left-0 w-0.5 bg-cafe" aria-hidden="true"></span>
            <span class="block font-mono text-xs text-texto-3">{f.problem}</span>
            <span class="mt-1.5 block font-display text-xl font-semibold tracking-[-0.025em] text-texto-2 transition-colors duration-[180ms] ease-[var(--ease-out)] group-hover:text-texto group-aria-selected:text-texto">{f.title}</span>
            <span class="mt-2 block text-[0.95rem] text-texto-2">{f.text}</span>
          </button>
        ))}
      </div>

      <div class="col-span-7">
        <div class="stage sticky top-24 grid rounded-[14px] p-4 xl:p-6" data-reveal="shot">
          {features.map((f, i) => (
            <div
              role="tabpanel"
              id={`panel-${f.id}`}
              aria-labelledby={`tab-${f.id}`}
              class="panel [grid-area:1/1] self-start"
              data-active={i === 0 ? '' : undefined}
            >
              {f.visual === 'shot' && <Screenshot src={f.img.src} alt={f.img.alt} sizes="(min-width: 1200px) 640px, 54vw" />}
              {f.visual === 'loyalty' && <LoyaltyCardMock />}
              {f.visual === 'phone' && (
                <div class="shot flex justify-center bg-banda! px-6 py-10">
                  <Picture
                    src={movilImg}
                    alt="Coffee POS en un celular: menú con fotos de los productos y barra inferior para ver la orden"
                    formats={['avif', 'webp']}
                    widths={[256, 512, 834]}
                    sizes="240px"
                    loading="lazy"
                    decoding="async"
                    class="block h-auto w-60 rounded-[22px] border border-borde"
                  />
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- MÓVIL: lista simple, cada función con su captura debajo -->
    <ol class="mt-12 space-y-16 lg:hidden">
      {features.map((f) => (
        <li class="border-t border-borde pt-6">
          <p class="font-mono text-xs text-texto-3">{f.problem}</p>
          <h3 class="mt-1.5 text-2xl">{f.title}</h3>
          <p class="mt-3 text-texto-2">{f.text}</p>
          <div class="stage mt-6 rounded-[12px] p-2" data-reveal="shot">
            {f.visual === 'shot' && <Screenshot src={f.img.src} alt={f.img.alt} sizes="calc(100vw - 2rem)" />}
            {f.visual === 'loyalty' && <LoyaltyCardMock />}
            {f.visual === 'phone' && (
              <div class="shot flex justify-center bg-banda! px-6 py-8">
                <Picture
                  src={movilImg}
                  alt="Coffee POS en un celular: menú con fotos de los productos y barra inferior para ver la orden"
                  formats={['avif', 'webp']}
                  widths={[256, 512, 834]}
                  sizes="208px"
                  loading="lazy"
                  decoding="async"
                  class="block h-auto w-52 rounded-[20px] border border-borde"
                />
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>

    <!-- En camino: una línea, para que no compita con lo que ya funciona -->
    <div class="mt-20 flex flex-col gap-2 border-t border-borde pt-6 sm:flex-row sm:items-baseline sm:gap-6">
      <p class="shrink-0 font-mono text-xs text-texto-3 uppercase tracking-[0.08em]">Próximamente</p>
      <p class="text-texto-2"><span class="font-medium text-texto">{soon.title}.</span> {soon.text}</p>
    </div>
  </div>
</section>

<script>
  // Tabs accesibles: clic o flechas ↑/↓ (también Inicio/Fin) cambian la función activa.
  const root = document.querySelector<HTMLElement>('[data-tabs]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];

    const select = (next: HTMLButtonElement, focus = false) => {
      for (const t of tabs) {
        const on = t === next;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.toggleAttribute('data-active', on);
      }
      if (focus) next.focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const map: Record<string, number> = {
          ArrowDown: (i + 1) % tabs.length,
          ArrowUp: (i - 1 + tabs.length) % tabs.length,
          Home: 0,
          End: tabs.length - 1,
        };
        if (e.key in map) {
          e.preventDefault();
          select(tabs[map[e.key]], true);
        }
      });
    });
  }
</script>
