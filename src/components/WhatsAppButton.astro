---
import { site } from '../config/site';

interface Props {
  label?: string;
  variant?: 'primary' | 'light' | 'dark';
  class?: string;
}
const { label = 'Agenda una demo gratis', variant = 'primary', class: className = '' } = Astro.props;

const styles = {
  primary: 'bg-acento-500 text-tinta shadow-glow hover:bg-acento-400 focus-visible:outline-acento-400',
  light: 'bg-acento-500 text-tinta shadow-glow hover:bg-acento-400 focus-visible:outline-cafe-900',
  dark: 'bg-tinta text-papel shadow-[0_14px_30px_-10px_rgb(20_16_13/0.6)] hover:bg-crema-50 focus-visible:outline-tinta',
};
---

<a
  href={site.whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  class={`inline-flex min-h-12 items-center justify-center gap-2.5 rounded-full px-6 py-3 text-base font-bold press lift focus-visible:outline-2 focus-visible:outline-offset-2 ${styles[variant]} ${className}`}
>
  <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 shrink-0" fill="currentColor">
    <path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.47-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.44-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.6-.92-2.2-.24-.58-.48-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.48.71.31 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35ZM12.04 21.8h-.01a9.8 9.8 0 0 1-5-1.37l-.36-.21-3.72.97 1-3.62-.24-.37a9.8 9.8 0 0 1-1.5-5.22c0-5.42 4.41-9.83 9.84-9.83a9.77 9.77 0 0 1 6.95 2.88 9.77 9.77 0 0 1 2.88 6.95c0 5.43-4.42 9.83-9.84 9.83Zm8.37-18.2A11.75 11.75 0 0 0 12.04.13C5.5.13.18 5.45.18 11.98c0 2.09.55 4.13 1.59 5.93L.08 24l6.24-1.64a11.82 11.82 0 0 0 5.71 1.46h.01c6.53 0 11.85-5.32 11.86-11.86 0-3.17-1.23-6.15-3.48-8.39Z"/>
  </svg>
  {label}
</a>
