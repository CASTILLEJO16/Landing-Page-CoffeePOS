---
import { site } from '../config/site';

interface Props {
  label?: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}
const { label = 'Agenda una demo', variant = 'primary', class: className = '' } = Astro.props;
---

<a
  href={site.whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  class={`btn btn-${variant} group ${className}`}
>
  {label}
  <span class="arrow" aria-hidden="true">→</span>
</a>
