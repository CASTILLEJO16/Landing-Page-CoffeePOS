---
import { plan } from '../config/site';
import WhatsAppButton from './WhatsAppButton.astro';
import Screenshot from './Screenshot.astro';
// Captura principal: reemplaza src/assets/screenshots/hero.png
import heroImg from '../assets/screenshots/hero.png';

// Datos concretos que se ven en la captura o vienen del plan (nada inventado).
const facts = [
  { label: 'Cobro', value: 'Efectivo, tarjeta, dólares o mixto' },
  { label: 'Atajos', value: 'Enter cobra, Esc cancela' },
  { label: 'Equipo', value: 'Tablet, computadora o celular' },
  { label: 'Precio', value: `$${plan.price} ${plan.currency} al ${plan.period}` },
];
---

<section id="inicio" class="pt-16 pb-24 sm:pt-24 lg:pt-28 lg:pb-32">
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6">
    <div class="grid gap-8 lg:grid-cols-12">
      <h1 class="enter text-[2.4rem] leading-[1.04] sm:text-6xl lg:col-span-9 lg:text-[4.5rem]" style="--i: 0">
        El punto de venta hecho para cafeterías.
        <span class="text-texto-3">Instalado en persona, en Tijuana.</span>
      </h1>

      <p class="enter max-w-xl text-lg text-texto-2 lg:col-span-6 lg:col-start-1" style="--i: 1">
        Cobra un latte con leche de avena y jarabe de vainilla sin hacer cuentas, suma el sello de lealtad
        de tu cliente al cobrar y revisa a qué hora vendes más. Todo desde el equipo que ya tienes.
      </p>

      <div class="enter flex flex-wrap items-center gap-x-5 gap-y-3 lg:col-span-6 lg:col-start-1" style="--i: 2">
        <WhatsAppButton />
        <p class="text-sm text-texto-2">
          {plan.badges.join(' · ')}
        </p>
      </div>
    </div>

    <!-- Escenario oscuro: la captura clara resalta. Entra al cargar y se "acuesta" al hacer scroll. -->
    <div class="enter-shot mt-16 lg:mt-20" style="--i: 4">
      <div class="stage rounded-[16px] p-2 sm:p-5 lg:p-8">
        <div class="tilt">
          <Screenshot
            src={heroImg}
            alt="Pantalla de caja de Coffee POS: menú con fotos por categoría y una orden de Cold Brew con leche de soya y una galleta, total $125"
            eager
            sizes="(min-width: 1200px) 1088px, calc(100vw - 3rem)"
          />
        </div>
      </div>
    </div>

    <!-- Hechos concretos, alineados con la captura. Sin íconos: el texto basta. -->
    <dl class="enter mt-10 grid grid-cols-2 gap-x-6 gap-y-6 border-t border-borde pt-6 lg:grid-cols-4" style="--i: 5">
      {facts.map((f) => (
        <div>
          <dt class="font-mono text-xs text-texto-3 uppercase tracking-[0.08em]">{f.label}</dt>
          <dd class="mt-1.5 text-[0.95rem] text-texto">{f.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
