---
import { site } from '../config/site';

// Compromisos concretos. Lista con líneas de 1px, sin tarjetas ni íconos.
const promises = [
  { label: 'Instalación', text: 'Voy a tu cafetería, cargamos tu menú juntos y capacito a tu equipo.' },
  { label: 'Soporte', text: 'Por WhatsApp, directo conmigo. No hablas con un call center en otro país.' },
  { label: 'Ubicación', text: 'Tijuana, B.C. Estoy en tu misma ciudad.' },
];

const bio = site.authorBio.charAt(0).toLowerCase() + site.authorBio.slice(1);
---

<section class="border-t border-borde bg-banda py-20 lg:py-32">
  <div class="mx-auto grid max-w-[1200px] gap-12 px-4 sm:px-6 lg:grid-cols-12">
    <h2 class="text-4xl leading-[1.08] sm:text-5xl lg:col-span-5" data-reveal>No es un programa de caja más. Lo instalo yo.</h2>

    <div class="lg:col-span-6 lg:col-start-7" data-reveal style="--d: 1">
      <p class="text-lg text-texto-2">
        Soy <a href={site.authorUrl} target="_blank" rel="noopener" class="text-link">{site.author}</a>, {bio}
        Desarrollé Coffee POS y te atiendo yo mismo.
      </p>

      <dl class="mt-10 border-t border-borde">
        {promises.map((p) => (
          <div class="grid gap-1 border-b border-borde py-5 sm:grid-cols-[8rem_1fr] sm:gap-6">
            <dt class="font-mono text-xs text-texto-3 uppercase tracking-[0.08em] sm:pt-1">{p.label}</dt>
            <dd class="text-texto">{p.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
