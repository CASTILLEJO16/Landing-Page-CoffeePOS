---
// Captura real del sistema, sin marco decorativo: borde de 1px y radio de 10px.
// Para reemplazarla, sustituye el archivo en src/assets/screenshots/ (mismo nombre = no tocas código).
// Astro la convierte a AVIF/WebP en varios tamaños al compilar.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  eager?: boolean;
  sizes?: string;
  class?: string;
}
const {
  src,
  alt,
  eager = false,
  sizes = '(min-width: 1200px) 680px, (min-width: 1024px) 56vw, calc(100vw - 2rem)',
  class: className = '',
} = Astro.props;
---

<figure class={`shot ${className}`}>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={[480, 800, 1200, src.width]}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
    class="block h-auto w-full"
  />
</figure>
